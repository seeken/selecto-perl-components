#!/usr/bin/env perl

use 5.034;
use strict;
use warnings;

use Digest::SHA qw(sha256_hex);
use File::Compare qw(compare);
use File::Copy qw(copy);
use File::Path qw(make_path);
use File::Spec;
use FindBin qw($Bin);
use JSON::PP qw(decode_json);

my $check = @ARGV == 1 && $ARGV[0] eq '--check';
die "Usage: script/sync-api-console [--check]\n" if @ARGV && !$check;

my $repo = File::Spec->rel2abs(File::Spec->catdir($Bin, '..'));
my $sibling = $ENV{SELECTO_LIVE_SELECTO_WEB}
    // File::Spec->catdir($repo, '..', 'selecto-api-console');
my $installed = File::Spec->catdir(
    $repo, 'node_modules', '@selecto', 'api-console', 'dist'
);
my $dist = $ENV{SELECTO_API_CONSOLE_DIST};
if (!defined $dist) {
    $dist = -f File::Spec->catfile($sibling, 'package.json')
        ? File::Spec->catdir($sibling, 'dist')
        : $installed;
}
if ($dist eq File::Spec->catdir($sibling, 'dist')) {
    system('node', File::Spec->catfile($sibling, 'scripts', 'build.mjs')) == 0
        or die "Cannot build the sibling Selecto API Console\n";
}
my $manifest_path = File::Spec->catfile($dist, 'manifest.json');
open my $manifest_file, '<:raw', $manifest_path
    or die "Cannot read $manifest_path: $!\n";
my $manifest_json = do { local $/; <$manifest_file> };
close $manifest_file or die "Cannot close $manifest_path: $!\n";
my $manifest = decode_json($manifest_json);
die "Unsupported Selecto API Console asset manifest\n"
    unless ($manifest->{format} // '') eq 'selecto.api-console.assets.v1';

my @files = qw(
    compatibility.json
    index.html
    selecto-api-console.css
    selecto-api-console.js
    selecto-importer.css
    selecto-importer.js
);
my $target = File::Spec->catdir($repo, 'public', 'selecto-api-console');
make_path($target) unless $check;
for my $file (@files) {
    my $source = File::Spec->catfile($dist, $file);
    open my $source_file, '<:raw', $source or die "Cannot read $source: $!\n";
    my $content = do { local $/; <$source_file> };
    close $source_file or die "Cannot close $source: $!\n";
    my $expected = $manifest->{assets}{$file}{sha256} // '';
    die "Digest mismatch for $source\n" unless sha256_hex($content) eq $expected;
    _sync_or_check($source, File::Spec->catfile($target, $file), $check);
}
_sync_or_check($manifest_path, File::Spec->catfile($target, 'manifest.json'), $check);
my $license = File::Spec->catfile($dist, '..', 'LICENSE');
_sync_or_check($license, File::Spec->catfile($target, 'LICENSE'), $check);

say(($check ? 'Verified' : 'Synced') . " Selecto API Console $manifest->{version} from $dist");

sub _sync_or_check {
    my ($source, $destination, $check) = @_;
    if ($check) {
        die "Stale Selecto API Console asset: $destination\n"
            unless -f $destination && compare($source, $destination) == 0;
        return;
    }
    copy($source, $destination) or die "Cannot copy $source: $!\n";
}
