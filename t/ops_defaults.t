use 5.034;
use strict;
use warnings;
use Test::More;
use lib 't/lib';
use TestSelectoComponents;
use Selecto::Components::Config;
use Selecto::Components::Explorer;
use Selecto::Components::State;
use Selecto::Components::Renderer::Builder;
use Selecto::Domain;
my $c=TestSelectoComponents::domain()->contract;
$c->{query_library}={segments=>{standalone_orders=>{filters=>[['not_null','id']]},group_members=>{filters=>[['is_null','id']]}},segment_picker_groups=>{count_as=>{label=>'Count as',default=>'standalone_orders',default_views=>[qw(aggregate graph)],choices=>[{segment=>'standalone_orders',label=>'Standalone orders'},{segment=>'group_members',label=>'Group members'}]}}};
my $d=Selecto::Domain->parse($c,strict=>1);
my $config=Selecto::Components::Config->new(%{TestSelectoComponents::config()},id=>'ops_defaults');
sub build_state {Selecto::Components::State->from_input($config,$d,{q=>1,field=>'product_name',view=>'aggregate',group=>'category.category_name',@_})}
my $s=build_state();
ok $s->valid,'default state valid' or diag explain $s->errors;
is_deeply $s->query_library_segments,['standalone_orders'],'omitted group gets default';
unlike join('|',@{$s->query_pairs}),qr/standalone_orders/,'permalink omits default';
like(Selecto::Components::Renderer::Builder->_query_library_filter_controls($s,$d,$config),qr/value="standalone_orders"[^>]*checked/,'default radio selected');
my $off=build_state(query_library_segment_choice_count_as=>'');
is_deeply $off->query_library_segments,[],'explicit Off suppresses default';
my %pairs=@{$off->query_pairs};
ok exists($pairs{query_library_segment_choice_count_as}) && $pairs{query_library_segment_choice_count_as} eq '', 'permalink retains explicit Off';
is_deeply build_state(view=>'detail')->query_library_segments,[],'Detail does not inherit aggregate-only default';
my $drill=Selecto::Components::Explorer::_drilldown_for_group_indexes($s,[],{},[]);
my %drill=@$drill;
is $drill{query_library_segment},'standalone_orders','drilldown freezes effective segment';
is_deeply(Selecto::Components::State->from_input($config,$d,\%drill)->query_library_segments,['standalone_orders'],'Detail keeps aggregate choice');
my $other=build_state(query_library_segment_choice_count_as=>'group_members');
is_deeply $other->query_library_segments,['group_members'],'explicit different choice';
like join('|',@{$other->query_pairs}),qr/group_members/,'permalink retains different choice';
done_testing;
